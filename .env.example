# ==============================================================================
# S-SPARC AI & E-STRANGE Platform - Environment Configuration Template
# Salin file ini menjadi `.env` dan isi sesuai kredensial server Anda.
# ==============================================================================

# === 1. Google Gemini Multi-Provider Pool (Cloud LLM) ===
# Menyediakan rotasi otomatis 6 API Keys dengan round-robin & rate-limit failover
GEMINI_API_KEY_1=AIzaSy...your_gemini_key_1_here
GEMINI_API_KEY_2=AIzaSy...your_gemini_key_2_here
GEMINI_API_KEY_3=AIzaSy...your_gemini_key_3_here
GEMINI_API_KEY_4=AIzaSy...your_gemini_key_4_here
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_MODEL=gemini-2.0-flash-lite

# === 2. Ollama Local LLM Runtime (On-Premises / Offline Fallback) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# === 3. Hybrid LLM Adaptive Router & Gamification Settings ===
# Aturan untuk Course Game ON (game_course.is_active = 1):
MIN_POINTS_CLOUD=100
POINTS_PER_CLOUD_REQUEST=10

# Aturan untuk Course Game OFF (game_course.is_active = 0):
GAME_OFF_TOKEN_LIMIT=5000

# === 4. Application Security ===
SECRET_KEY=your-secure-random-secret-key-min-32-chars
FLASK_SECRET_KEY=your-secure-random-secret-key-min-32-chars

# === 5. MySQL Database Configuration ===
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_database_password
MYSQL_DB=db_semantic_final

# === 6. PHPMyAdmin (Docker Setup) ===
PHPMYADMIN_HOST=localhost
PHPMYADMIN_PORT=8080

# === 7. CodeCarbon Environmental Footprint Tracking ===
CODECARBON_COUNTRY_ISO_CODE=IDN
CODECARBON_PUE=1.12

# === 8. Neo4j Graph & Vector Database (Optional) ===
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
VECTOR_DIMENSIONS=768

# === 9. Code Evaluator Quality Control Service ===
EVALUATOR_PORT=5055
EVALUATOR_BATCH_SIZE=50
EVALUATOR_SEMANTIC_THRESHOLD=0.75
EVALUATOR_REVIEW_SCORE_THRESHOLD=7.0
EVALUATOR_FINAL_SCORE_THRESHOLD=6.0
EVALUATOR_DRY_RUN=false
