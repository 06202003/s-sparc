# S-SPARC AI Environment Configuration
# Copy this file to .env and fill in your values

# === OpenAI API ===
OPENAI_API_KEY=sk-your-openai-api-key-here

# === Flask Configuration ===
FLASK_SECRET_KEY=your-super-secret-key-here-change-this-in-production
FLASK_BASE_URL=http://localhost:5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# === Database Configuration ===
# Note: Database connection is configured in get_db_connection() function in app.py
# Default: localhost:3306, user=root, password=passwordku, database=db_semantic
# Modify app.py if you need different credentials

# === Waitress Production Server ===
WAITRESS_THREADS=8

# === Server Identification ===
# Used for carbon emission tracking
SERVER_NAME=s-sparc-lab-server-01

# === Carbon Tracking ===
# Emissions tracker is enabled by default with Indonesia settings (IDN)
# To change country code, modify PUE and CIF constants in app.py
