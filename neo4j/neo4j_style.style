# Neo4j Browser Style Configuration
# This file customizes the appearance of nodes and relationships in the Neo4j Browser.

# Style for User nodes
node.User {
    color: #6A5ACD;  # SlateBlue color
    border-color: #483D8B;  # DarkSlateBlue color
    border-width: 2px;
    text-color-internal: #FFFFFF;  # White text
    caption: '{id}';  # Display the user ID as the caption
}

# Style for CodeSnippet nodes
node.CodeSnippet {
    color: #FFD700;  # Gold color
    border-color: #FFA500;  # Orange color
    border-width: 2px;
    text-color-internal: #000000;  # Black text
    caption: '{id}';  # Display the snippet ID as the caption
}

# Style for CREATED relationships
relationship.CREATED {
    color: #32CD32;  # LimeGreen color
    shaft-width: 2px;
    font-size: 10px;
    text-color-external: #000000;  # Black text
    text-color-internal: #FFFFFF;  # White text
    caption: 'CREATED';
}